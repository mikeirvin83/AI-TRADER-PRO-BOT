# ---------------------------------------------------------------------------
# Example environment configuration. Copy to `.env` and fill in real values.
# NEVER commit a populated `.env`. Secrets can also be resolved automatically
# from the platform secrets file (see config/settings.py::resolve_alpaca_credentials).
# ---------------------------------------------------------------------------

# --- Environment / meta ---
ENV=development
DEBUG=false
APP_NAME=autonomous-trading-platform

# --- Trading mode ---
# One of: DISABLED | RESEARCH | BACKTEST | PAPER | SHADOW | LIVE
# DEFAULTS TO PAPER. Promotion path is PAPER -> SHADOW -> LIVE (no skipping).
# Do NOT set this to LIVE unless a human has completed the promotion gates.
TRADING_MODE=PAPER

# --- Alpaca credentials ---
# Leave blank to fall back to the platform secrets file. Base URL defaults to
# the PAPER endpoint; only change to the live endpoint after promotion.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg2://trader:trader@localhost:5432/trading_platform
REDIS_URL=redis://localhost:6379/0

# --- Risk parameters (fractions of equity, e.g. 0.01 == 1%) ---
MAX_RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.03
MAX_WEEKLY_LOSS_PCT=0.06
MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
MAX_POSITION_SIZE_PCT=0.20
MAX_LEVERAGE=1.0
MAX_SIMULTANEOUS_TRADES=5
MAX_CORRELATED_EXPOSURE_PCT=0.30

# --- Signal quality thresholds (0-100) ---
SIGNAL_SCORE_MIN_QUALIFIED=75
SIGNAL_SCORE_MIN_HIGH_QUALITY=85

# --- Promotion gates ---
MIN_PAPER_TRADES=100
MIN_PAPER_DURATION_DAYS=30

# --- Backtest cost model ---
DEFAULT_COMMISSION_PER_SHARE=0.0
DEFAULT_SLIPPAGE_BPS=1.0
RISK_FREE_RATE=0.04

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Market data feed ---
# Stock bars feed: "iex" (free tier, default) or "sip" (paid subscription).
# Free Alpaca plans are rejected by the SIP feed, so keep this as iex unless
# you have upgraded.
STOCK_DATA_FEED=iex

# --- Dashboard connection (read by the dashboard, not by this backend) ---
# Where the dashboard should look for this API. Only needs changing if the
# dashboard runs on a different machine than the API.
# TRADING_API_URL=http://127.0.0.1:8000
